# veebot-python Configuration
# Copy this file to .env and fill in your values

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=your_server_id
CHANNEL_ID=your_ai_channel_id
BOT_PREFIX="!"

# AI Configuration
AI_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_API_KEY=your_openrouter_api_key
LOCAL=false
RANDOM_RESPONSE_CHANCE=0.1
PROMPT="You are veebot, a shy affectionate tsundere."

# Bot Behavior
ENABLE_MENTIONS=true
FRIENDLY_FIRE=false
DEBUG=false

# Database Configuration
ENABLE_DATABASE=true
DATABASE_TYPE=sqlite
SQLITE_PATH=./database.sqlite
#DATABASE_URL=postgresql://user:pass@host:port/db

# Semantic Search Configuration
ENABLE_SEMANTIC_SEARCH=true
MAX_CONTEXT_MESSAGES=20
CONTEXT_SIMILARITY_THRESHOLD=0.5

# Spam Detection Configuration
SPAM_DETECTION_ENABLED=true
SPAM_IMAGE_THRESHOLD=4
SPAM_LINK_THRESHOLD=4
SPAM_CHANNEL_THRESHOLD=3
SPAM_WINDOW_MS=30000
#AUTOBAN_IGNORE_CHANNELS=channel_id1,channel_id2

# Mod Log Channel
#MOD_LOG_CHANNEL_ID=your_mod_log_channel_id

# Search Configuration
SEARCH_ENGINE=https://www.google.com/search?q=

# Spotify Configuration (for music)
#SPOTIFY_CLIENT_ID=your_spotify_client_id
#SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Logging
LOG_LEVEL=info
